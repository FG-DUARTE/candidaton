# Plantilla de CANDIDATON. No contiene credenciales.
# Copiar a .env.local y sustituir allí los valores del proyecto.
# .env, .env.local y el resto de archivos .env* siguen fuera de Git.
# .env.example es el único archivo de entorno que se versiona.
# La clave de servicio no lleva prefijo NEXT_PUBLIC_: solo la lee el servidor.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
